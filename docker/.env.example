# TindaFlow production environment for docker compose. Copy to docker/.env (git-ignored) and fill in.
# One file feeds the app, the migrate step, the database container and the backup container.

# --- Application ------------------------------------------------------------------------------------------------
APP_NAME=TindaFlow
APP_ENV=production
APP_DEBUG=false
# The HTTPS address terminals use. Cookies are Secure, so plain HTTP will not sign anyone in.
APP_URL=https://tindaflow.lan
# php artisan key:generate --show   (back this up separately from the database: without it every session and every
# enrolled terminal's credential becomes unreadable)
APP_KEY=
# The store's timezone: business dates, date filters, printed invoice times, CSV offsets.
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# --- Database: two roles ---------------------------------------------------------------------------------------------
# The OWNER creates and migrates the tables (the postgres container is created with it). Only the one-shot `migrate`
# service and the restore script use it; the running app never sees it.
DB_OWNER_USERNAME=tindaflow_owner
# Use a long random password (openssl rand -base64 24)
DB_OWNER_PASSWORD=
# The APPLICATION role the running app connects as. It must be exactly `tindaflow_app`: the database refuses it any
# UPDATE or DELETE on the append-only tables (invariants #2, #41, #45, #48), which is what makes a bug or a stolen
# credential unable to rewrite sales history. `migrate` creates it and sets this password. A different long password.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tindaflow
DB_USERNAME=tindaflow_app
DB_PASSWORD=
# Upgrading a stack that used one role (DB_USERNAME=tindaflow)? Keep that login as the owner:
#   DB_OWNER_USERNAME=tindaflow   DB_OWNER_PASSWORD=<the old DB_PASSWORD>
# and give DB_USERNAME=tindaflow_app a NEW password. See docker/README.md, "Upgrading from one database role".

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- First deploy only: `docker compose run --rm app php artisan db:seed --force` creates one ADMIN and prints a
# generated password once. -----------------------------------------------------------------------------------------
TINDAFLOW_INITIAL_STORE_NAME="My Sari-Sari Store"
TINDAFLOW_INITIAL_ADMIN_EMAIL=admin@example.com

# --- Published ports (change them only if 80 and 443 are taken) -------------------------------------------------------
# HTTP_PORT=80
# HTTPS_PORT=443
# TLS_CERT_DIR=./certs

# --- Backups ------------------------------------------------------------------------------------------------------
# A dump every BACKUP_INTERVAL_MINUTES: the most sales you can lose is one interval. Kept: every backup for
# BACKUP_KEEP_HOURLY_HOURS, then the first of each day for BACKUP_KEEP_DAILY_DAYS, then the first of each month for
# BACKUP_KEEP_MONTHLY_MONTHS.
BACKUP_INTERVAL_MINUTES=60
BACKUP_KEEP_HOURLY_HOURS=24
BACKUP_KEEP_DAILY_DAYS=30
BACKUP_KEEP_MONTHLY_MONTHS=12
# Where the dumps go on the host. Use a different disk from the database volume.
# BACKUP_DIR=/mnt/backup-disk/tindaflow
# Set a passphrase to encrypt every dump (AES-256). KEEP IT SOMEWHERE ELSE: an encrypted backup is useless without it.
# BACKUP_PASSPHRASE=
# A command that copies a finished backup off the machine; it gets the file path as its first argument ($1), e.g.
#   BACKUP_UPLOAD_COMMAND='rclone copy "$1" remote:tindaflow-backups/'
# BACKUP_UPLOAD_COMMAND=
