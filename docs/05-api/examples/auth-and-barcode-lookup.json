  "refund_with_non_cash_settlement": {
    "_comment": "Variant of the refund example where the store returns money via GCash instead of cash -- demonstrates the settlement.payment_method distinction and that a non-CASH settlement does not affect physical drawer cash (Stage 2 invariant #71).",
    "request": {
      "method": "POST", "path": "/api/v1/sales/sale-monday-1/refunds",
      "headers": { "Idempotency-Key": "d4e5f6a7-b8c9-4d0e-1f2a-3b4c5d6e7f8a" },
      "body": {
        "items": [ { "sale_item_id": "si-monday-1", "quantity": "1.000", "disposition": "RETURN_TO_STOCK" } ],
        "settlements": [ { "payment_method": "GCASH", "amount": "50.00", "external_reference": "GC-REFUND-889021" } ],
        "reason": "Customer preferred a GCash refund"
      }
    },
    "response_201": {
      "id": "refund-friday-2",
      "sale_id": "sale-monday-1",
      "status": "COMPLETED",
      "refund_total": "50.00",
      "settlements": [
        { "id": "rs-2", "payment_method": "GCASH", "amount": "50.00", "external_reference": "GC-REFUND-889021", "processed_at": "2026-09-18T17:00:00+08:00" }
      ],
      "_note": "This settlement does NOT reduce the processing shift's expected physical drawer cash -- only a CASH-method settlement does (Stage 2 invariant #71). It still counts toward the store's overall Refund Report."
    }
  }
