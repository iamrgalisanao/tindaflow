# TindaFlow POS -- environment template. Copy to .env and fill in.
# The full production checklist is docs/06-backend/stage-23-production-readiness.md.
#
# PRODUCTION, at minimum:
#   APP_ENV=production           APP_DEBUG=false          APP_URL=https://<your host>
#   APP_KEY=<php artisan key:generate --show>  (keep it: it decrypts every session and terminal credential)
#   DB_PASSWORD=<a strong password>   LOG_LEVEL=warning   LOG_STACK=daily
#   SESSION_SECURE_COOKIE is on by default outside local/testing; the site must be served over HTTPS.

APP_NAME=TindaFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The store's own timezone. Business dates, date filters, printed invoice times and CSV offsets all use it
# (stage 23, decision D1). Instants are stored as absolute timestamps either way. The database session follows it.
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# "daily" rotates the file (LOG_DAILY_DAYS old files are kept); "single" grows forever.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# Use "warning" in production. Every line carries the request_id that the response's X-Request-ID also holds.
LOG_LEVEL=debug

# PostgreSQL is required (partial indexes, timestamptz, row locks the design relies on); SQLite is not supported.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tindaflow
DB_USERNAME=tindaflow
DB_PASSWORD=
# DB_SSLMODE=prefer
# Leave DB_TIMEZONE unset: it must equal APP_TIMEZONE (config/database.php).
# DB_TIMEZONE=Asia/Manila

# First deploy only: `php artisan db:seed --force` creates one ADMIN and prints a generated password once.
# TINDAFLOW_INITIAL_STORE_NAME="My Sari-Sari Store"
# TINDAFLOW_INITIAL_ADMIN_EMAIL=admin@example.com
# TINDAFLOW_INITIAL_ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_COOKIE=tindaflow_session
# SESSION_SAME_SITE=strict
# SESSION_SECURE_COOKIE=true

# LOGIN_THROTTLE_MAX_ATTEMPTS=5
# LOGIN_THROTTLE_DECAY_MINUTES=1
# Ceiling on API requests per signed-in user per minute (a till makes a few a second at most).
# API_THROTTLE_PER_MINUTE=600

# TERMINAL_CREDENTIAL_LIFETIME_MINUTES=2628000

# A CASH_OUT above this amount needs the CASH_OUT capability. Set it to the store's own policy.
# CASH_OUT_AUTHORIZATION_THRESHOLD=1000.00

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
